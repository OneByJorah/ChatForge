# ─────────────────────────────────────────────────────────────
# ChatForge — Cloudflare Workers Environment Variables
# Copy to .env before deploying. No runtime secrets are required
# for local `wrangler dev` because the Workers AI binding is configured
# in wrangler.jsonc.
# ─────────────────────────────────────────────────────────────

# Cloudflare API credentials (required only for deployment)
CLOUDFLARE_API_TOKEN=<set-value>
CLOUDFLARE_ACCOUNT_ID=<set-value>

# Optional: Custom worker name (defaults to "chatforge" from wrangler.jsonc)
# WORKER_NAME=chatforge
